# Copy to .env at the repository root. No AI key is needed.
# Optional: leave DATABASE_URL unset to run the stateless slice.
# DATABASE_URL=postgresql+psycopg://tencerem:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/tencerem
POSTGRES_USER=tencerem
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_DB=tencerem
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Next's server proxy defaults to this URL; set in frontend/.env.local if changing it.
BACKEND_URL=http://127.0.0.1:8000

# Phase 3 accounts require PostgreSQL DATABASE_URL above and Alembic upgrade head.
ENVIRONMENT=development
# Generate locally; never use the placeholder as a real secret.
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Local HTTP only. Production requires true and HTTPS.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=3600
# SQLite is never a production fallback. Only the isolated test helper enables it.
ALLOW_TEST_SQLITE=false

# Phase 4: optional server-only decision support. No key required for fallback.
AI_ENABLED=false
AI_API_KEY=REPLACE_WITH_PRIVATE_API_KEY
# Select a model supporting strict Structured Outputs; no model is silently chosen.
AI_MODEL=
AI_TIMEOUT_SECONDS=6
